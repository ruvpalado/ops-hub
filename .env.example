# Names only. No values, no example values. Real values come from the
# environment or from scripts/dev_db.py in development.
#
# DATABASE_URL
# OPSHUB_SECRET_KEY    Django signing key. Required; there is no default.
# OPSHUB_TOKEN_KEY      32 random bytes, base64. Generate with: openssl rand -base64 32
# OPSHUB_ENV            development | test | production
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# GOOGLE_REDIRECT_URI
# OPSHUB_ALLOW_SIGNUP
# OPSHUB_SIGNUP_INVITE_ONLY
# OPSHUB_TOKEN_MAX_AGE_DAYS
# OPSHUB_TOKEN_WARN_BEFORE_DAYS
DATABASE_URL=
OPSHUB_TOKEN_KEY=
OPSHUB_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Workspace domains allowed to claim an account; empty means nobody.
ALLOWED_EMAIL_DOMAINS=
OPSHUB_ALLOW_SIGNUP=
OPSHUB_SIGNUP_INVITE_ONLY=
OPSHUB_TOKEN_MAX_AGE_DAYS=
OPSHUB_TOKEN_WARN_BEFORE_DAYS=
